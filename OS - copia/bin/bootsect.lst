     1                                  [org 0x7c00]
     2                                  [bits 16]
     3                                  
     4                                  %include "boot_sectors.inc"
     5                              <1> %define SECTOR_COUNT 274
     5                                  
     6                                  ; Save boot drive
     7 00000000 8816[EC00]              mov [boot_drive], dl
     8                                  
     9                                  ; Setup DS
    10 00000004 31C0                    xor ax, ax
    11 00000006 8ED8                    mov ds, ax
    12                                  
    13                                  ; Load kernel to 0x10000 (64KB mark) - safe from bootloader
    14                                  ; Use ES:BX = 0x1000:0x0000 = 0x10000 physical
    15 00000008 B80010                  mov ax, 0x1000
    16 0000000B 8EC0                    mov es, ax
    17 0000000D 31DB                    xor bx, bx              ; ES:BX = 0x1000:0x0000 = 0x10000
    18                                  
    19                                  ; Generic CHS read loop (1.44MB floppy geometry: 18 sectors/track, 2 heads)
    20                                  ; Start from C/H/S 0/0/2 and load SECTOR_COUNT sectors.
    21 0000000F C706[ED00]1201          mov word [sectors_left], SECTOR_COUNT
    22 00000015 C606[F300]00            mov byte [cur_cyl], 0
    23 0000001A C606[F400]00            mov byte [cur_head], 0
    24 0000001F C606[F500]02            mov byte [cur_sector], 2
    25 00000024 C706[EF00]0010          mov word [load_seg], 0x1000
    26 0000002A C706[F100]0000          mov word [load_off], 0
    27                                  
    28                                  read_loop:
    29 00000030 A1[ED00]                    mov ax, [sectors_left]
    30 00000033 83F800                      cmp ax, 0
    31 00000036 7467                        je read_done
    32                                  
    33 00000038 A1[EF00]                    mov ax, [load_seg]
    34 0000003B 8EC0                        mov es, ax
    35 0000003D 8B1E[F100]                  mov bx, [load_off]
    36 00000041 8A2E[F300]                  mov ch, [cur_cyl]
    37 00000045 8A0E[F500]                  mov cl, [cur_sector]
    38 00000049 8A36[F400]                  mov dh, [cur_head]
    39 0000004D B402                        mov ah, 0x02
    40 0000004F B001                        mov al, 1           ; Read one sector per iteration
    41 00000051 8A16[EC00]                  mov dl, [boot_drive]
    42 00000055 CD13                        int 0x13
    43 00000057 7261                        jc disk_error
    44                                  
    45                                      ; Advance destination by 512 bytes, fixing 64KB boundary crossings.
    46 00000059 A1[F100]                    mov ax, [load_off]
    47 0000005C 050002                      add ax, 512
    48 0000005F A3[F100]                    mov [load_off], ax
    49 00000062 730F                        jnc next_chs
    50 00000064 A1[EF00]                    mov ax, [load_seg]
    51 00000067 050010                      add ax, 0x1000
    52 0000006A A3[EF00]                    mov [load_seg], ax
    53 0000006D C706[F100]0000              mov word [load_off], 0
    54                                  
    55                                  next_chs:
    56 00000073 A0[F500]                    mov al, [cur_sector]
    57 00000076 FEC0                        inc al
    58 00000078 A2[F500]                    mov [cur_sector], al
    59 0000007B 3C13                        cmp al, 19
    60 0000007D 721A                        jb chs_ok
    61 0000007F C606[F500]01                mov byte [cur_sector], 1
    62 00000084 A0[F400]                    mov al, [cur_head]
    63 00000087 FEC0                        inc al
    64 00000089 A2[F400]                    mov [cur_head], al
    65 0000008C 3C02                        cmp al, 2
    66 0000008E 7209                        jb chs_ok
    67 00000090 C606[F400]00                mov byte [cur_head], 0
    68 00000095 FE06[F300]                  inc byte [cur_cyl]
    69                                  chs_ok:
    70 00000099 FF0E[ED00]                  dec word [sectors_left]
    71 0000009D EB91                        jmp read_loop
    72                                  
    73                                  read_done:
    74                                  
    75                                  ; Print 'C' - all done
    76 0000009F B40E                    mov ah, 0x0e
    77 000000A1 B043                    mov al, 'C'
    78 000000A3 CD10                    int 0x10
    79                                  
    80                                  ; Switch to protected mode
    81 000000A5 FA                      cli
    82 000000A6 0F0116[0E01]            lgdt [GDT_DESC]
    83                                  
    84 000000AB 0F20C0                  mov eax, cr0
    85 000000AE 6683C801                or eax, 1
    86 000000B2 0F22C0                  mov cr0, eax
    87                                  
    88 000000B5 EA[C200]0800            jmp CODE_SEG:INIT_PM
    89                                  
    90                                  disk_error:
    91 000000BA B40E                        mov ah, 0x0e
    92 000000BC B058                        mov al, 'X'
    93 000000BE CD10                        int 0x10
    94 000000C0 EBFE                        jmp $
    95                                  
    96                                  [bits 32]
    97                                  
    98                                  INIT_PM:
    99 000000C2 66B81000                    mov ax, DATA_SEG
   100 000000C6 8ED8                        mov ds, ax
   101 000000C8 8ED0                        mov ss, ax
   102 000000CA 8EC0                        mov es, ax
   103 000000CC 8EE0                        mov fs, ax
   104 000000CE 8EE8                        mov gs, ax
   105                                      
   106 000000D0 BD00000900                  mov ebp, 0x90000
   107 000000D5 89EC                        mov esp, ebp
   108                                      
   109                                      ; Debug 'D' in video memory
   110 000000D7 C60506800B0044              mov byte [0xb8006], 'D'
   111 000000DE C60507800B000F              mov byte [0xb8007], 0x0f
   112                                      
   113                                      ; Kernel is now at 0x10000
   114 000000E5 E8(00000100)                call 0x10000
   115 000000EA EBFE                        jmp $
   116                                  
   117                                  ; Data
   118 000000EC 00                      boot_drive: db 0
   119 000000ED 0000                    sectors_left: dw 0
   120 000000EF 0000                    load_seg: dw 0
   121 000000F1 0000                    load_off: dw 0
   122 000000F3 00                      cur_cyl: db 0
   123 000000F4 00                      cur_head: db 0
   124 000000F5 00                      cur_sector: db 0
   125                                  
   126                                  ; GDT
   127                                  GDT_BEGIN:
   128 000000F6 0000000000000000            dd 0, 0
   129                                  
   130                                  GDT_CODE_SEG:
   131 000000FE FFFF0000                    dw 0xffff, 0
   132 00000102 009ACF00                    db 0, 10011010b, 11001111b, 0
   133                                  
   134                                  GDT_DATA_SEG:
   135 00000106 FFFF0000                    dw 0xffff, 0
   136 0000010A 0092CF00                    db 0, 10010010b, 11001111b, 0
   137                                  
   138                                  GDT_END:
   139                                  
   140                                  GDT_DESC:
   141 0000010E 1700                        dw GDT_END - GDT_BEGIN - 1
   142 00000110 [F6000000]                  dd GDT_BEGIN
   143                                  
   144                                  CODE_SEG equ GDT_CODE_SEG - GDT_BEGIN
   145                                  DATA_SEG equ GDT_DATA_SEG - GDT_BEGIN
   146                                  
   147 00000114 00<rep EAh>             times 510-($-$$) db 0
   148 000001FE 55AA                    dw 0xaa55
